---
import type { GetStaticPaths } from "astro";
import { projects,type Project } from "../../data/portfolio";
import Layout from "../../layouts/Layout.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import Icon from "../../components/Icon.astro";
import Footer from "../../components/footer.astro";
import { withBase } from "../../utils/paths";
export const getStaticPaths = (() => projects.map(project => ({params:{slug:project.slug},props:{project}}))) satisfies GetStaticPaths;
interface Props { project: Project; }
const { project } = Astro.props;
const related = projects.filter(item => item.category === project.category && item.slug !== project.slug).slice(0,3);
---
<Layout title={`${project.title} · 吴江彬的项目空间`} description={project.summary}>
  <header class="detail-header container-width"><a href={withBase("#projects")}>‹ 返回全部项目</a><span>吴江彬的项目空间</span></header>
  <main id="main" class="container-width detail-main">
    <p class="section-label">{project.category} / {project.status}</p><h1>{project.title}</h1><p class="detail-subtitle">{project.subtitle}</p><p class="detail-summary muted">{project.summary}</p>
    <div class="detail-actions">{project.github && <a class="button" href={project.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={21} />查看源码</a>}{project.demo && <a class="button button-primary" href={project.demo} target="_blank" rel="noopener noreferrer">{project.demoLabel}<Icon name="arrow" size={20} /></a>}</div>
    <figure><ProjectVisual project={project} /><figcaption>{project.image ? project.imageAlt : `${project.title} · 项目主题示意`}</figcaption></figure>
    <div class="detail-body"><section><h2>项目内容</h2><ul class="highlights">{project.highlights.map(item => <li>{item}</li>)}</ul>{project.note && <aside class="project-note"><h3>使用与实验说明</h3><p>{project.note}</p></aside>}</section><aside class="tech-panel"><h2>使用的技术</h2><div class="tags">{project.stack.map(item => <span class="tag">{item}</span>)}</div><p class="muted">{project.status}</p></aside></div>
    {related.length > 0 && <section class="related"><h2>继续看看</h2><div>{related.map(item => <a href={withBase(`projects/${item.slug}/`)}><span>{item.title}</span><Icon name="arrow" size={20} /></a>)}</div></section>}
  </main><Footer />
</Layout>
<style>
  .detail-header { display:flex; gap:18px; align-items:center; justify-content:space-between; padding-block:30px; color:#aaa3b7; font-size:13px; }.detail-header a:hover { color:var(--sec); }.detail-header span { color:#8d8a94; }
  .detail-main { padding-block:65px 70px; }h1 { font-size:clamp(32px,5vw,56px); font-weight:500; line-height:1.35; letter-spacing:-.035em; }.detail-subtitle { margin-top:14px; font-size:19px; color:#c1b5d1; }.detail-summary { margin-top:20px; max-width:700px; font-size:17px; line-height:1.9; }.detail-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:26px; }
  figure { margin:42px 0; overflow:hidden; border-radius:16px; border:1px solid var(--line); }figure :global(.visual) { max-height:480px; aspect-ratio:2.1; }figcaption { padding:12px 20px; font-size:12px; color:#9b94a5; background:#17151c; }
  .detail-body { display:grid; grid-template-columns:1fr 250px; gap:60px; }h2 { font-size:23px; font-weight:500; margin-bottom:22px; }.highlights { padding-left:20px; margin:0; color:#b4b0bb; }.highlights li { padding-left:6px; margin-bottom:15px; }.highlights li::marker { color:var(--sec); }.tech-panel { padding-left:25px; border-left:1px solid var(--line); }.tech-panel p { font-size:13px; margin-top:20px; }
  .project-note { margin-top:30px; padding:20px; border-left:2px solid #a476ff66; background:#a476ff08; }.project-note h3 { font-size:14px; font-weight:500; color:#c9b6e3; margin-bottom:9px; }.project-note p { font-size:13px; line-height:1.9; color:#aaa1b6; }
  .related { margin-top:55px; padding-top:35px; border-top:1px solid var(--line); }.related div { display:grid; grid-template-columns:repeat(3,1fr); gap:15px; }.related a { display:flex; justify-content:space-between; gap:10px; align-items:center; padding:17px; border:1px solid var(--line); border-radius:10px; font-size:13px; }.related a:hover { border-color:#a476ff66; color:var(--sec); }
  @media (max-width:767px) { .detail-main { padding-block:35px 48px; }.detail-header { font-size:12px; }.detail-header span { display:none; }.detail-subtitle { font-size:16px; }.detail-summary { font-size:15px; }.detail-body { grid-template-columns:1fr; gap:30px; }.tech-panel { padding:25px 0 0; border-left:0; border-top:1px solid var(--line); }.related div { grid-template-columns:1fr; }figure :global(.visual) { aspect-ratio:1.5; } }
</style>
