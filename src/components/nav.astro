---
const items = [{label:"首页",href:"#home",path:"m3 11 9-8 9 8v10h-6v-7H9v7H3V11Z"},{label:"项目",href:"#projects",path:"M3 5h7l2 2h9v13H3V5Z"},{label:"关于我",href:"#contact",path:"M3 3h18v14H8l-5 4V3Z"}];
---
<nav id="main-nav" aria-label="主导航"><ul>{items.map((item,index) => <li><a href={item.href} class:list={[{active:index === 0}]} aria-current={index === 0 ? "location" : undefined}><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d={item.path} /></svg><span>{item.label}</span></a></li>)}</ul></nav>
<style>
  nav { position:fixed; left:50%; transform:translateX(-50%); top:23px; z-index:100; width:80%; max-width:1120px; background:#101010e8; backdrop-filter:blur(16px); border:1px solid transparent; border-radius:999px; transition:max-width .4s,border-color .3s,background .3s; }
  nav.scrolling { max-width:510px; border-color:#ffffff14; background:#171719ed; }ul { display:flex; align-items:center; justify-content:center; gap:70px; padding:16px 20px; margin:0; list-style:none; }a { display:flex; gap:7px; align-items:center; position:relative; color:#a1a1ac; font-size:14px; }a:hover,a.active { color:#eeeaf5; }a.active::before { content:""; position:absolute; left:-16px; width:5px; height:5px; border-radius:50%; background:#a9ff5b; }svg { display:none; }
  @media(max-width:767px) { nav,nav.scrolling { top:auto; bottom:0; width:100%; max-width:none; border-radius:16px 16px 0 0; border-color:#ffffff14; background:#171719f5; }ul { justify-content:space-around; gap:25px; padding:12px 15px calc(12px + env(safe-area-inset-bottom)); }a { flex-direction:column; font-size:11px; gap:3px; }svg { display:block; }a.active::before { display:none; } }
</style>
<script>
  const nav = document.getElementById("main-nav");
  const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section[id]"));
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("#main-nav a"));
  let pending = false;
  function updateNav() {
    nav?.classList.toggle("scrolling",window.scrollY > 20);
    let active = sections[0]?.id;
    for (const section of sections) { if (section.getBoundingClientRect().top <= 160) active = section.id; }
    links.forEach(link => {
      const selected = link.hash === `#${active}`;
      link.classList.toggle("active",selected);
      if (selected) link.setAttribute("aria-current","location"); else link.removeAttribute("aria-current");
    });
    pending = false;
  }
  window.addEventListener("scroll",() => { if (!pending) { pending = true; requestAnimationFrame(updateNav); } },{passive:true});
  window.addEventListener("resize",updateNav);
  updateNav();
</script>
