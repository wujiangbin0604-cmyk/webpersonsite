---
import LetterGlitch from "../React/LetterGlitch";
import LogoWall from "./logoWall.astro";
import SkillsList from "../React/SkillsList";
import Icon from "./Icon.astro";
import { profile } from "../data/portfolio";
---
<section id="home" class="hero container-width">
  <p class="intro">你好，我是 {profile.name}<span> / {profile.englishName}</span></p>
  <div class="hero-heading"><h1>软件开发<br />与机器学习</h1><p>{profile.description}</p></div>
  <div class="hero-actions">
    <a class="button" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" />GitHub</a>
    <a class="button" href="#projects"><Icon name="folder" />浏览我的项目</a>
  </div>
  <LogoWall />
  <div class="skills-layout"><SkillsList client:visible /><div class="glitch" aria-hidden="true"><LetterGlitch client:visible glitchColors={["#5e4491","#A476FF","#241a38"]} glitchSpeed={50} centerVignette={false} outerVignette={true} smooth={true} /></div></div>
</section>
<style>
  .hero { padding-block:165px 70px; scroll-margin-top:100px; }
  .intro { font-size:18px; color:#c6c6cc; margin-bottom:22px; }
  .intro span { color:#85858f; font-size:15px; }
  .hero-heading { display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; }
  h1 { font-size:clamp(42px,5.2vw,64px); line-height:1.22; letter-spacing:-.045em; font-weight:500; }
  .hero-heading p { font-size:21px; color:var(--white-icon); line-height:1.9; max-width:420px; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-block:30px 16px; }
  .skills-layout { display:grid; grid-template-columns:1fr 1fr; gap:65px; align-items:center; }
  .glitch { width:100%; height:290px; overflow:hidden; }
  @media (max-width:767px) { .hero { padding-top:52px; padding-bottom:48px; } .hero-heading { grid-template-columns:1fr; gap:22px; } .hero-heading p { font-size:17px; } .skills-layout { grid-template-columns:1fr; gap:20px; } .glitch { height:190px; } .intro { font-size:16px; } .intro span { font-size:12px; } }
</style>
