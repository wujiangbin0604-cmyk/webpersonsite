---
import { profile } from "../data/portfolio";
import { withBase } from "../utils/paths";
interface Props { title: string; description?: string; }
const { title, description = profile.description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="吴江彬的项目空间" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">跳到正文</a><slot /></body>
</html>
<style is:global>
  :root { color-scheme: dark; --background:#101010; --sec:#a476ff; --white:#dfdfdf; --white-icon:#a3a3a8; --white-icon-tr:#ffffff10; --component-bg:#171719f5; --line:#ffffff14; --container:#171719; font-family:"Segoe UI","Microsoft YaHei","PingFang SC",system-ui,sans-serif; color:var(--white); background:var(--background); font-synthesis:none; }
  * { box-sizing:border-box; }
  body { margin:0; padding:0 36px; line-height:1.7; }
  h1,h2,h3,h4,p { margin:0; }
  a { color:inherit; text-decoration:none; }
  button,input { font:inherit; }
  button,a,input { -webkit-tap-highlight-color:transparent; }
  button { cursor:pointer; }
  a:focus-visible,button:focus-visible,summary:focus-visible { outline:2px solid var(--sec); outline-offset:5px; }
  input:focus-visible { outline:2px solid var(--sec); outline-offset:2px; }
  ::selection { background:var(--sec); color:var(--background); }
  .container-width { max-width:1024px; margin-inline:auto; }
  .muted { color:var(--white-icon); }
  .section { padding-block:68px; border-top:1px solid var(--line); scroll-margin-top:100px; }
  .section-label { color:var(--sec); font-size:15px; margin-bottom:8px; }
  .section-title { font-size:clamp(30px,4.2vw,46px); font-weight:500; line-height:1.3; letter-spacing:-.035em; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:10px; border:1px solid #ffffff1a; padding:11px 18px; border-radius:12px; color:var(--white); background:#ffffff04; transition:background .2s,border-color .2s; }
  .button:hover { background:#ffffff0d; border-color:#a476ff70; }
  .button-primary { color:#101010; background:var(--sec); border-color:var(--sec); font-weight:600; }
  .button-primary:hover { background:#b894ff; }
  .tags { display:flex; gap:7px; flex-wrap:wrap; }
  .tag { display:inline-flex; padding:3px 9px; font-size:12px; color:#b6b6c0; border:1px solid var(--line); border-radius:6px; }
  .skip-link { position:fixed; left:20px; top:-100px; z-index:200; padding:12px; background:var(--sec); color:#101010; }
  .skip-link:focus { top:12px; }
  .shiny-sec { color:var(--sec); }
  [hidden] { display:none !important; }
  html { scroll-behavior:smooth; }
  .skills h2 { font-size:30px; font-weight:500; letter-spacing:-.03em; margin-bottom:20px; }
  .skills-items { display:grid; gap:12px; }
  .skill { border:1px solid var(--line); border-radius:14px; background:#ffffff02; overflow:hidden; }
  .skill button { width:100%; display:flex; align-items:center; gap:12px; text-align:left; color:var(--white); padding:17px; background:transparent; border:0; font-size:16px; }
  .skill button svg { color:var(--sec); flex-shrink:0; }
  .skill-toggle { margin-left:auto; color:#888894; }
  .skill ul { margin:0; padding:0 22px 20px 50px; font-size:13px; color:var(--white-icon); line-height:2; }
  @media (min-width:768px) { body { padding-inline:64px; } }
  @media (max-width:767px) { body { padding:0 22px 82px; } .section { padding-block:48px; scroll-margin-top:24px; } }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { animation:none !important; transition:none !important; } }
</style>
